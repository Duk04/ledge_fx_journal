# Copy this file to .env and fill in real values before running the app.
# See docs/AUTH.md for the full picture of how auth is wired up.

# ---------------------------------------------------------------------------
# Database (Prisma, via the pg driver adapter — see src/lib/db.ts)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/fxjournal?schema=public"
# Only needed if you use a separate connection for migrations (e.g. through
# a pooler for DATABASE_URL). Safe to set equal to DATABASE_URL otherwise.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/fxjournal?schema=public"

# ---------------------------------------------------------------------------
# Auth.js core
# ---------------------------------------------------------------------------
# Signing secret for session JWTs and CSRF tokens. REQUIRED — validated at
# boot by src/lib/env.ts, which enforces a 32-character minimum and refuses
# the old placeholder value outright when NODE_ENV=production.
#
# Deliberately blank: this file used to ship a working secret, which made
# "copy .env.example and forget" the path of least resistance, and every
# deployment that took it shared one signing key with every other.
#
#   openssl rand -base64 32
AUTH_SECRET=""

# The canonical origin of this deployment. Must match what you actually
# serve on (including scheme + port) — OAuth redirect URIs are derived from
# it.
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google OAuth (optional) — leave both blank to disable the provider
# entirely; it is only registered when BOTH are non-empty.
# Create credentials at https://console.cloud.google.com/apis/credentials
# and add "<AUTH_URL>/api/auth/callback/google" as an authorized redirect URI.
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Resend magic-link email (optional) — leave blank to disable; only
# registered when AUTH_RESEND_KEY is non-empty. Get a key at
# https://resend.com/api-keys.
# ---------------------------------------------------------------------------
AUTH_RESEND_KEY=""
EMAIL_FROM="journal@example.com"

# ---------------------------------------------------------------------------
# Storage (S3-compatible). Empty in dev -> local disk fallback.
# ---------------------------------------------------------------------------
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Error reporting (optional) — Sentry stays completely off while these are
# blank. SENTRY_DSN is the server side; NEXT_PUBLIC_SENTRY_DSN is inlined into
# the browser bundle at BUILD time, so set it before `npm run build`. Request
# bodies, cookies and query strings are never sent (src/lib/sentry-options.ts).
# ---------------------------------------------------------------------------
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# ---------------------------------------------------------------------------
# Auth feature flags
# ---------------------------------------------------------------------------
# Enables email + password sign-in. Default: on.
#
# Renamed from ALLOW_DEV_LOGIN, which is now REJECTED at boot rather than
# ignored — silently ignoring it would leave a deployment believing it had
# disabled password login when it had not. The rename reflects a change of
# intent: the Credentials provider is throttled per email and per IP
# (src/lib/auth/throttle.ts), so it is a supported production login method
# rather than a development shortcut. Previously it had to be off in
# production, which left production with no password login at all.
ALLOW_PASSWORD_LOGIN="true"

# Require a confirmed email address before a session is issued. Default: off,
# because gating a public demo behind a mail provider is how you ship a
# broken demo. Needs AUTH_RESEND_KEY; env.ts refuses the combination without
# it, since otherwise nobody — including you — could ever verify.
REQUIRE_EMAIL_VERIFICATION="false"

# Comma-separated addresses promoted to OWNER on sign-in. OWNER is the
# instance administrator: the only role permitted to write the shared
# Instrument and Candle tables, whose contents feed every user's P&L
# arithmetic. Everyone else is a MEMBER.
#
# The auth_hardening migration promotes the oldest existing user, which is
# right for a database that already has one but fragile if it is ever reset.
# This is the durable way to say who the administrator is.
AUTH_OWNER_EMAILS=""

# Enables the self-service "Create an account" form on /login. Set to
# "false" for an invite-only deployment; sign-in for existing users is
# untouched either way. Parsed as a boolean now ("true"/"false"/"1"/"0"),
# rather than the old "anything that isn't the literal string false".
#
# Registration is rate-limited per IP regardless (5/hour, 20/day): it creates
# a User row and a TradingAccount row per call, so unthrottled it is an
# unbounded write amplifier.
ALLOW_REGISTRATION="true"

# Skips environment validation entirely. Only for a CI build that has no
# real database URL — "next build" evaluates module scope while collecting
# pages, so validation would otherwise fail the build.
# SKIP_ENV_VALIDATION="1"
