// Forex trading journal — database schema
//
// See docs/DATA-MODEL.md for the narrative reference (table purposes, the
// row-level-security approach, and why computed trade metrics are stored
// columns backfilled by a single function rather than being recomputed ad hoc).

generator client {
  provider = "prisma-client-js"
  // No `engineType` here: the standard native query engine is the default and
  // is what you want on any machine that can reach binaries.prisma.sh. The
  // pure-JS engine (`engineType = "client"`) plus a driver adapter is the
  // fallback for locked-down networks — see docs/DATA-MODEL.md.
}

datasource db {
  provider  = "postgresql"
  // The app connects through DATABASE_URL (pooled); migrations go through
  // DIRECT_URL (an unpooled session connection) because PgBouncer in
  // transaction mode supports neither prepared statements nor advisory locks.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AuthAttemptKind {
  PASSWORD_LOGIN
  REGISTER
  PASSWORD_RESET
  EMAIL_VERIFY
}

enum UserRole {
  OWNER
  MEMBER
}

enum Platform {
  MT5
  MT4
  CTRADER
  OTHER
}

enum AccountType {
  DEMO
  LIVE
  PROP
  /// Holds backtest trades. Kept as an account type rather than a separate
  /// table so every existing report — equity curve, R distribution, session
  /// breakdown — works on a backtest with no new code, while still never
  /// mixing simulated fills into a live account's statistics.
  BACKTEST
}

enum AssetClass {
  FX
  METAL
  INDEX
  CRYPTO
  ENERGY
}

enum Direction {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum MarketSession {
  SYDNEY
  TOKYO
  LONDON
  NEW_YORK @map("NEWYORK") // Prisma-side name; the stored value stays NEWYORK
  OVERLAP
  OFFHOURS
}

enum TagKind {
  SETUP
  MISTAKE
  SESSION
  CUSTOM
}

enum AttachmentKind {
  BEFORE
  AFTER
  OTHER
}

/// Bar size. M1 is the base everything else can be aggregated from; the app
/// stores whatever you import and derives coarser bars on read when it can.
enum Timeframe {
  M1
  M5
  M15
  M30
  H1
  H4
  D1
  W1
}

enum DrawdownMode {
  STATIC
  TRAILING
}

enum ExecutionKind {
  ENTRY
  EXIT
}

enum StatementSource {
  MT4_HTML
  MT5_HTML
  CSV
}

enum CandleSource {
  MT5_CSV
  GENERIC_CSV
  API
}

/// REPLAY: you step through bars and place the orders yourself.
/// STRATEGY: code decides, and the engine runs it over the whole range.
enum BacktestKind {
  REPLAY
  STRATEGY
}

enum BacktestStatus {
  DRAFT
  RUNNING
  DONE
  FAILED
}

enum BalanceEventKind {
  DEPOSIT
  WITHDRAWAL
  ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Core identity / Auth.js
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String?
  image             String?
  passwordHash      String?   @map("password_hash")
  /// Required by @auth/prisma-adapter: its createUser passes emailVerified
  /// (as a Date for magic links, null for OAuth), and its stripUndefined only
  /// drops undefined — so without this column every Google and Resend sign-up
  /// failed with "Unknown argument emailVerified".
  emailVerified     DateTime? @map("email_verified")
  /// MEMBER by default. This was OWNER, which with open registration minted
  /// an instance owner on every sign-up. OWNER now means the single
  /// administrator who may write the shared Instrument and Candle tables.
  role              UserRole  @default(MEMBER)
  timezone          String    @default("Asia/Ulaanbaatar")
  /// UI language: "en" or "mn" (src/i18n/config.ts). The NEXT_LOCALE cookie
  /// carries it per request; this is the durable copy it is set from at
  /// sign-in, and what anything without a request (email) reads.
  locale            String    @default("en")
  /// Any session token issued before this instant is rejected by the DAL.
  /// This is how "sign out everywhere" works under a JWT strategy, where
  /// there is no server-side session row to delete: a password reset or
  /// change stamps it, and getCurrentUser() compares it to the token's
  /// authAt claim. Per-user, not per-device — see docs/AUTH.md.
  sessionsValidFrom DateTime? @map("sessions_valid_from")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  accounts        TradingAccount[]
  tags            Tag[]
  journalEntries  JournalEntry[]
  authAccounts    Account[]
  candleImports   CandleImport[]
  strategies      Strategy[]
  backtestRuns    BacktestRun[]
  authAttempts    AuthAttempt[]
  revokedSessions RevokedSession[]
  symbolAliases   SymbolAlias[]
  tradeImports    TradeImport[]
  playbooks       Playbook[]

  @@map("users")
}

// Auth.js (next-auth) Prisma adapter models. Field names on these three
// models must match what @auth/prisma-adapter expects verbatim — only the
// table name is remapped via @@map.
/// MUST be named `Account` even though the table is `auth_accounts`:
/// @auth/prisma-adapter calls `prisma.account.findUnique` / `.create` /
/// `.delete` (see its getUserByAccount/linkAccount/unlinkAccount). With the
/// model named AuthAccount, the client exposed `prisma.authAccount` and
/// `prisma.account` was undefined, so every OAuth sign-in threw a TypeError.
/// The @@map keeps the table name, so no data moves.
/// One signed-out session token, by its `sid` claim. A JWT session has no
/// server-side row to delete, and Auth.js's middleware re-sets the session
/// cookie on every request — so a request still in flight when the user signs
/// out (a Link prefetch, say) brings the cookie straight back. Recording the
/// token here makes the DAL reject it however it returns. Per token, unlike
/// User.sessionsValidFrom, which signs out every device.
///
/// Rows are only needed until the token would have expired anyway
/// (`expiresAt`, = issue time + session maxAge); signOutAction prunes older
/// ones as it goes.
model RevokedSession {
  sid       String   @id
  userId    String   @map("user_id")
  revokedAt DateTime @default(now()) @map("revoked_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("revoked_sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("userId")
  type              String
  provider          String
  providerAccountId String  @map("providerAccountId")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

/// One row per authentication attempt. Both the sliding window the throttle
/// reads and a record of what was tried.
///
/// Postgres rather than an in-memory Map because this deploys as a possibly
/// multi-instance serverless app: N instances each with their own counter
/// means N times the threshold, and a cold start is a free reset for an
/// attacker. This is the only shared state the app has.
model AuthAttempt {
  id        String          @id @default(uuid())
  kind      AuthAttemptKind
  /// Lowercased email when known. Recorded even for addresses that do not
  /// exist, so lockout timing and messaging are identical either way and
  /// cannot be used to enumerate accounts.
  email     String?
  /// Best-effort: only trustworthy behind a proxy that overwrites
  /// x-forwarded-for. The email bucket is the real gate.
  ip        String?
  success   Boolean         @default(false)
  userId    String?         @map("user_id")
  createdAt DateTime        @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([kind, email, createdAt])
  @@index([kind, ip, createdAt])
  @@index([createdAt])
  @@map("auth_attempts")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Trading domain
// ---------------------------------------------------------------------------

model TradingAccount {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  label             String
  broker            String?
  platform          Platform
  accountType       AccountType  @map("account_type")
  currency          String       @default("USD")
  startingBalance   Decimal      @map("starting_balance") @db.Decimal(18, 2)
  riskPerTradePct   Decimal?     @map("risk_per_trade_pct") @db.Decimal(6, 3)
  /// Prop-firm challenge rules (src/lib/prop.ts). All optional; an account
  /// with none set shows no challenge panel. Percents of starting balance.
  dailyLossLimitPct Decimal?     @map("daily_loss_limit_pct") @db.Decimal(6, 3)
  maxDrawdownPct    Decimal?     @map("max_drawdown_pct") @db.Decimal(6, 3)
  drawdownMode      DrawdownMode @default(STATIC) @map("drawdown_mode")
  profitTargetPct   Decimal?     @map("profit_target_pct") @db.Decimal(6, 3)
  minTradingDays    Int?         @map("min_trading_days")
  isArchived        Boolean      @default(false) @map("is_archived")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades        Trade[]
  balanceEvents BalanceEvent[]
  backtestRuns  BacktestRun[]
  tradeImports  TradeImport[]

  @@index([userId])
  @@map("accounts")
}

model Instrument {
  symbol        String     @id
  displayName   String     @map("display_name")
  pipSize       Decimal    @map("pip_size") @db.Decimal(18, 8)
  contractSize  Decimal    @map("contract_size") @db.Decimal(18, 4)
  digits        Int
  baseCurrency  String?    @map("base_currency")
  quoteCurrency String     @map("quote_currency")
  assetClass    AssetClass @map("asset_class")
  isActive      Boolean    @default(true) @map("is_active")

  trades  Trade[]
  candles Candle[]
  aliases SymbolAlias[]

  @@map("instruments")
}

model Trade {
  id        String @id @default(uuid())
  accountId String @map("account_id")
  symbol    String

  direction Direction
  status    TradeStatus @default(OPEN)

  openedAt DateTime  @map("opened_at")
  closedAt DateTime? @map("closed_at")

  entryPrice      Decimal  @map("entry_price") @db.Decimal(18, 8)
  exitPrice       Decimal? @map("exit_price") @db.Decimal(18, 8)
  stopLoss        Decimal? @map("stop_loss") @db.Decimal(18, 8)
  /// Where the stop was at entry. Risk and R are measured against this, so a
  /// stop trailed to breakeven does not distort R (lib/metrics/trade.ts).
  initialStopLoss Decimal? @map("initial_stop_loss") @db.Decimal(18, 8)
  /// Maximum adverse / favourable excursion: the worst and best price the
  /// position saw while open. Entered by hand, or filled from M1 candles
  /// (src/lib/metrics/excursion.ts). Analytics express them in R.
  maePrice        Decimal? @map("mae_price") @db.Decimal(18, 8)
  mfePrice        Decimal? @map("mfe_price") @db.Decimal(18, 8)
  takeProfit      Decimal? @map("take_profit") @db.Decimal(18, 8)

  volumeLots     Decimal  @map("volume_lots") @db.Decimal(12, 4)
  commission     Decimal  @default(0) @db.Decimal(18, 2)
  swap           Decimal  @default(0) @db.Decimal(18, 2)
  conversionRate Decimal? @map("conversion_rate") @db.Decimal(18, 8) // quote ccy -> account ccy, at close

  // --- Computed-and-stored columns -----------------------------------
  // Populated by a backfill step (lib/metrics), never hand-entered.
  // See docs/DATA-MODEL.md for the rationale.
  netPnl         Decimal?       @map("net_pnl") @db.Decimal(18, 2)
  grossPnl       Decimal?       @map("gross_pnl") @db.Decimal(18, 2)
  pips           Decimal?       @db.Decimal(12, 2)
  rMultiple      Decimal?       @map("r_multiple") @db.Decimal(10, 4)
  riskAmount     Decimal?       @map("risk_amount") @db.Decimal(18, 2)
  holdingMinutes Int?           @map("holding_minutes")
  marketSession  MarketSession? @map("market_session")

  /// Set when this trade came out of a backtest rather than a real fill.
  backtestRunId String? @map("backtest_run_id")

  followedPlan   Boolean? @map("followed_plan")
  emotion        Int?
  confidence     Int?
  notes          String?
  externalTicket String?  @map("external_ticket")
  /// The broker's own gross profit, from an imported statement — the ground
  /// truth our computed grossPnl is checked against (docs/IMPORT.md).
  brokerProfit   Decimal? @map("broker_profit") @db.Decimal(18, 2)
  /// The setup this trade was taken as (docs/PLAYBOOKS.md). Null = none.
  playbookId     String?  @map("playbook_id")
  /// The statement import that created this trade; lets an import be undone.
  importId       String?  @map("import_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account     TradingAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrument  Instrument       @relation(fields: [symbol], references: [symbol])
  attachments Attachment[]
  tradeTags   TradeTag[]
  backtestRun BacktestRun?     @relation(fields: [backtestRunId], references: [id], onDelete: Cascade)
  tradeImport TradeImport?     @relation(fields: [importId], references: [id], onDelete: SetNull)
  executions  Execution[]
  playbook    Playbook?        @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  ruleChecks  TradeRuleCheck[]

  @@unique([accountId, externalTicket])
  @@index([accountId, openedAt(sort: Desc)])
  @@index([accountId, symbol])
  @@index([accountId, status])
  @@index([backtestRunId])
  @@index([importId])
  @@index([playbookId])
  @@map("trades")
}

model Tag {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  name      String
  kind      TagKind
  color     String  @default("#33488F")
  sortOrder Int     @default(0) @map("sort_order")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeTags TradeTag[]

  @@unique([userId, kind, name])
  @@map("tags")
}

model TradeTag {
  tradeId String @map("trade_id")
  tagId   String @map("tag_id")

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
  @@index([tagId])
  @@map("trade_tags")
}

model Attachment {
  id          String         @id @default(uuid())
  tradeId     String         @map("trade_id")
  kind        AttachmentKind @default(OTHER)
  storageKey  String?        @map("storage_key")
  externalUrl String?        @map("external_url")
  mimeType    String?        @map("mime_type")
  width       Int?
  height      Int?
  sizeBytes   Int?           @map("size_bytes")
  caption     String?
  createdAt   DateTime       @default(now()) @map("created_at")

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@map("attachments")
}

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  entryDate DateTime @map("entry_date") @db.Date
  preMarket String?  @map("pre_market")
  review    String?
  mood      Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
  @@map("journal_entries")
}

model BalanceEvent {
  id             String           @id @default(uuid())
  accountId      String           @map("account_id")
  kind           BalanceEventKind
  amount         Decimal          @db.Decimal(18, 2)
  occurredAt     DateTime         @map("occurred_at")
  note           String?
  /// Broker deal/ticket id when imported from a statement; dedupe key.
  externalTicket String?          @map("external_ticket")
  importId       String?          @map("import_id")

  account     TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tradeImport TradeImport?   @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@unique([accountId, externalTicket])
  @@index([accountId, occurredAt(sort: Desc)])
  @@map("balance_events")
}

/// One fill of a trade: an ENTRY (opening or scaling in) or an EXIT (closing
/// all or part). The source of truth for a trade's prices and size — the
/// Trade row's entry/exit/volume/opened/closed are aggregates of these,
/// written only by trade-service (lib/metrics/fills.ts explains the
/// aggregate and why it is exact). Every trade has at least one ENTRY.
model Execution {
  id             String        @id @default(uuid())
  tradeId        String        @map("trade_id")
  kind           ExecutionKind
  executedAt     DateTime      @map("executed_at")
  price          Decimal       @db.Decimal(18, 8)
  volumeLots     Decimal       @map("volume_lots") @db.Decimal(12, 4)
  /// Broker deal id when imported; dedupe key within the trade.
  externalDealId String?       @map("external_deal_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, externalDealId])
  @@index([tradeId, executedAt])
  @@map("executions")
}

/// A setup the user trades, written down: a name and the rules that make a
/// trade an instance of it. Trades link to one; their checklist records which
/// rules were followed. docs/PLAYBOOKS.md.
model Playbook {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules  PlaybookRule[]
  trades Trade[]

  @@unique([userId, name])
  @@map("playbooks")
}

/// One rule of a playbook ("H4 trend agrees", "risk ≤ 1%"). Editing a
/// playbook's rules keeps the ids of rules whose text is unchanged, so past
/// checklists stay attached to them.
model PlaybookRule {
  id         String @id @default(uuid())
  playbookId String @map("playbook_id")
  text       String
  sortOrder  Int    @default(0) @map("sort_order")

  playbook Playbook         @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  checks   TradeRuleCheck[]

  @@index([playbookId, sortOrder])
  @@map("playbook_rules")
}

/// Whether one trade followed one rule of its playbook. Absent = not
/// answered, which is different from "no".
model TradeRuleCheck {
  tradeId  String  @map("trade_id")
  ruleId   String  @map("rule_id")
  followed Boolean

  trade Trade        @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  rule  PlaybookRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([tradeId, ruleId])
  @@index([ruleId])
  @@map("trade_rule_checks")
}

/// A broker symbol the user has told the importer how to read, e.g.
/// "GER30.cash" -> GER40. Per user: two brokers can use one name for
/// different things. See src/lib/statements/symbols.ts for the resolution order.
model SymbolAlias {
  id           String @id @default(uuid())
  userId       String @map("user_id")
  brokerSymbol String @map("broker_symbol")
  symbol       String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [symbol], references: [symbol])

  @@unique([userId, brokerSymbol])
  @@map("symbol_aliases")
}

/// One statement import: what file, which timezone reading, what it created.
/// Kept so "why is this trade at this hour" stays answerable, and so an
/// import can be undone as a unit (its trades and balance events point here).
model TradeImport {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  accountId       String          @map("account_id")
  source          StatementSource
  fileName        String?         @map("file_name")
  /// "ny-close" or "fixed"; with tzOffsetMinutes for the latter.
  tzMode          String          @map("tz_mode")
  tzOffsetMinutes Int?            @map("tz_offset_minutes")
  tradesCreated   Int             @map("trades_created")
  tradesSkipped   Int             @map("trades_skipped")
  balanceEvents   Int             @map("balance_events")
  createdAt       DateTime        @default(now()) @map("created_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  trades    Trade[]
  cashMoves BalanceEvent[]

  @@index([accountId, createdAt(sort: Desc)])
  @@map("trade_imports")
}

/// One OHLC bar. The primary key is (symbol, timeframe, ts) so re-importing an
/// overlapping range is an upsert rather than a duplicate — you can pull "last
/// 3 months" every week and never dedupe by hand.
///
/// SIZE WARNING: one year of M1 for a single symbol is roughly 370k rows /
/// ~35 MB. Supabase's free tier gives you 500 MB for the whole database, so
/// import the ranges you actually test, not everything your broker has.
model Candle {
  symbol    String
  timeframe Timeframe
  /// Bar OPEN time, always stored in UTC. See docs/BACKTEST.md on why the
  /// importer asks which timezone an MT5 export is in.
  ts        DateTime  @db.Timestamptz(3)

  open   Decimal  @db.Decimal(18, 8)
  high   Decimal  @db.Decimal(18, 8)
  low    Decimal  @db.Decimal(18, 8)
  close  Decimal  @db.Decimal(18, 8)
  volume Decimal? @db.Decimal(18, 4)
  /// MT5 exports the spread in points at bar close; used by the fill model
  /// when present, otherwise the run's fixed spread applies.
  spread Int?

  source CandleSource

  instrument Instrument @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@id([symbol, timeframe, ts])
  @@index([symbol, timeframe, ts(sort: Desc)])
  @@map("candles")
}

/// Audit trail for imports: what was loaded, from where, covering what range.
/// Without it, "why does my backtest stop on 12 March" is unanswerable.
model CandleImport {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  symbol          String
  timeframe       Timeframe
  source          CandleSource
  fileName        String?      @map("file_name")
  rowCount        Int          @map("row_count")
  fromTs          DateTime     @map("from_ts") @db.Timestamptz(3)
  toTs            DateTime     @map("to_ts") @db.Timestamptz(3)
  /// Offset applied to convert the file's timestamps to UTC, in minutes.
  tzOffsetMinutes Int          @default(0) @map("tz_offset_minutes")
  createdAt       DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol, timeframe])
  @@map("candle_imports")
}

/// A coded strategy. `code` is JavaScript, and it is inert data at rest: it
/// is compiled and executed ONLY in a Web Worker in the author's own browser
/// (src/lib/backtest/worker.ts), never in a server process. Saving it is not
/// a trust decision; running it on the server would be. See docs/BACKTEST.md
/// for the contract it must implement and BACKTEST-ENGINE.md for why.
model Strategy {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  name        String
  description String?
  code        String
  /// Default parameter values, shown in the run form and overridable per run.
  params      Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs BacktestRun[]

  @@unique([userId, name])
  @@map("strategies")
}

/// One backtest. Its trades live in a BACKTEST-type TradingAccount, so the
/// existing analytics read them without knowing what a backtest is.
model BacktestRun {
  id         String  @id @default(uuid())
  userId     String  @map("user_id")
  accountId  String  @map("account_id")
  strategyId String? @map("strategy_id")

  kind   BacktestKind
  status BacktestStatus @default(DRAFT)
  label  String?

  symbol    String
  timeframe Timeframe
  fromTs    DateTime  @map("from_ts") @db.Timestamptz(3)
  toTs      DateTime  @map("to_ts") @db.Timestamptz(3)

  initialBalance Decimal @map("initial_balance") @db.Decimal(18, 2)

  // --- Fill model. These are what separate an honest backtest from a lie. ---
  /// Spread charged on entry AND exit, in points. Ignored per-bar when the
  /// candle carries its own spread.
  spreadPoints     Int     @default(0) @map("spread_points")
  /// Commission per lot per side, in account currency.
  commissionPerLot Decimal @default(0) @map("commission_per_lot") @db.Decimal(18, 2)
  /// Extra adverse price movement applied to every fill, in points.
  slippagePoints   Int     @default(0) @map("slippage_points")
  /// When a bar's range contains both the stop and the target, assume the stop
  /// was hit first. Defaults on, because assuming otherwise flatters results.
  pessimisticFills Boolean @default(true) @map("pessimistic_fills")

  /// Parameter values this run used (a snapshot, so editing the strategy later
  /// does not rewrite history).
  params Json?
  /// Summary statistics, computed at the end and stored so the list page does
  /// not have to recompute every run.
  stats  Json?
  error  String?

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  strategy Strategy?      @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  trades   Trade[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([accountId])
  @@map("backtest_runs")
}
